generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  JUDGE
  TEAM
}

model User {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  email        String       @unique
  passwordHash String
  role         Role         @default(TEAM)
  mfaEnabled   Boolean      @default(false)
  mfaSecret    String?
  teamMembers  TeamMember[]
  auditLogs    AuditLog[]
}

model Team {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  status          String             @default("PENDING") // APPROVED, REJECTED, PENDING
  clusterId       String             @db.ObjectId
  cluster         Cluster            @relation(fields: [clusterId], references: [id])
  members         TeamMember[]
  pointLedger     PointLedger[]
  financialLedger FinancialLedger[]
  sourceRelations TeamRelationship[] @relation("SourceTeam")
  targetRelations TeamRelationship[] @relation("TargetTeam")
  submissions     Submission[]
  wagers          Wager[]
}

model TeamMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  teamId   String   @db.ObjectId
  role     String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  team     Team     @relation(fields: [teamId], references: [id])
}

model Cluster {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  teams Team[]
}

model TeamRelationship {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  sourceTeamId  String    @db.ObjectId
  targetTeamId  String    @db.ObjectId
  type          String
  status        String
  initiatedById String
  approvedById  String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  sourceTeam    Team      @relation("SourceTeam", fields: [sourceTeamId], references: [id])
  targetTeam    Team      @relation("TargetTeam", fields: [targetTeamId], references: [id])
}

model Round {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  number      Int          @unique
  name        String
  status      String
  opensAt     DateTime?
  closesAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
  wagers      Wager[]
}

model CompetitionState {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  currentState String
}

model RoundAccess {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  teamId  String @db.ObjectId
  roundId String @db.ObjectId
  status  String
}

model Submission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId    String   @db.ObjectId
  roundId   String   @db.ObjectId
  content   String
  timestamp DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  round     Round    @relation(fields: [roundId], references: [id])
}

model PointLedger {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId        String   @db.ObjectId
  delta         Int
  balanceAfter  Int
  reason        String
  referenceType String
  referenceId   String?
  createdAt     DateTime @default(now())
  team          Team     @relation(fields: [teamId], references: [id])
}

model FinancialLedger {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId        String   @db.ObjectId
  delta         Float
  balanceAfter  Float
  reason        String
  referenceType String
  referenceId   String?
  createdAt     DateTime @default(now())
  team          Team     @relation(fields: [teamId], references: [id])
}

model Wager {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId         String   @db.ObjectId
  roundId        String   @db.ObjectId
  amount         Int
  status         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  team           Team     @relation(fields: [teamId], references: [id])
  round          Round    @relation(fields: [roundId], references: [id])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  action    String
  resource  String
  payload   String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model EventRegistration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  rollNo    String
  phone     String
  gender    String
  events      String   // JSON array of event IDs
  teamDetails String?  // JSON string storing team name and teammates
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())
}

model StartupRegistration {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  startupName String
  founderName String
  email       String   @unique
  phone       String
  description String
  stage       String   // e.g., Idea, Prototype, MVP, Seed, etc.
  pitchDeck   String?  // Optional link to pitch deck
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}
